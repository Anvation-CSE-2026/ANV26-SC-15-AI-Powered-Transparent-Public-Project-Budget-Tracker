rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isProjectManager() {
      return hasRole('project_manager');
    }

    function isContractor() {
      return hasRole('contractor');
    }

    function isCitizen() {
      return hasRole('citizen');
    }

    // ==========================================
    // 1. Users Collection (users/{uid})
    // ==========================================
    match /users/{uid} {
      // Any authenticated user can read basic municipal profile
      // Or users can read their own full profile
      allow read: if isAuthenticated();

      // Creation only allowed if document ID matches the authenticated UID
      allow create: if isOwner(uid) &&
                    request.resource.data.uid == uid &&
                    request.resource.data.role in ['citizen', 'project_manager', 'contractor'] &&
                    request.resource.data.email is string &&
                    request.resource.data.username is string;

      // Update allowed only by the owner, BUT ROLE CANNOT BE CHANGED FROM CLIENT
      allow update: if isOwner(uid) &&
                    request.resource.data.role == resource.data.role &&
                    request.resource.data.uid == resource.data.uid;

      // Deletion prohibited from standard client
      allow delete: if false;
    }

    // ==========================================
    // 2. Usernames Index (usernames/{normalizedUsername})
    // ==========================================
    match /usernames/{normalizedUsername} {
      // Readable for login resolution and username uniqueness check
      allow read: if true;

      // Creation allowed only during registration when tied to authenticated UID
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid &&
                    !exists(/databases/$(database)/documents/usernames/$(normalizedUsername));

      // Usernames are immutable once registered
      allow update, delete: if false;
    }

    // ==========================================
    // 3. Projects Collection (projects/{projectId})
    // ==========================================
      // Public transparency: anyone authenticated can read public projects;
      // Project Managers can read all projects;
      // Contractors can read projects officially assigned to them
      allow read: if isAuthenticated() && (
        isProjectManager() ||
        (isContractor() && resource.data.contractorId == request.auth.uid) ||
        resource.data.isPublic == true
      );

      // Only Project Managers can create, update or delete projects
      allow create, update, delete: if isProjectManager();

      // Milestones Subcollection
      match /milestones/{milestoneId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isProjectManager();
      }

      // Updates Subcollection (Strict Citizen Isolation)
      match /updates/{updateId} {
        // Citizens can only read updates with visibility 'Public'
        // Internal staff memos are strictly restricted to project managers
        allow read: if isAuthenticated() && (
          isProjectManager() ||
          resource.data.visibility in ['Public', 'public']
        );
        allow create, update, delete: if isProjectManager();
      }

      // Issues Subcollection
      match /issues/{issueId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isProjectManager();
      }

      // Documents Subcollection
      match /documents/{docId} {
        allow read: if isAuthenticated() && (
          isProjectManager() ||
          resource.data.isPublic == true
        );
        allow create, update, delete: if isProjectManager();
      }

      // Photos Subcollection
      match /photos/{photoId} {
        allow read: if isAuthenticated() && (
          isProjectManager() ||
          resource.data.isPublic == true
        );
        allow create, update, delete: if isProjectManager();
      }

      // Audit Activity Trail Subcollection
      match /activity/{activityId} {
        allow read: if isProjectManager();
        allow create: if isProjectManager();
        allow update, delete: if false;
      }
    }

    // ==========================================
    // 4. Complaints Collection (complaints/{complaintId})
    // ==========================================
    match /complaints/{complaintId} {
      // Public transparency: citizens and authority can read complaints
      allow read: if isAuthenticated();

      // Citizen can create complaint with their own citizenId
      allow create: if isAuthenticated() &&
                    request.resource.data.citizenId == request.auth.uid;

      // Citizen can update only their own complaint while under review
      // Authority (PM) can update status, SLA, and department assignment
      allow update: if (isAuthenticated() && resource.data.citizenId == request.auth.uid) ||
                    isProjectManager();

      allow delete: if isProjectManager();

      // Updates and Audit Timeline Subcollection
      match /updates/{updateId} {
        // Public updates are visible to all authenticated users
        // Internal notes (isInternal == true) are strictly restricted to project managers
        allow read: if isAuthenticated() && (
          isProjectManager() ||
          resource.data.isInternal == false
        );

        // Authenticated users can log lifecycle events (citizens log submissions & feedback ratings)
        // Project managers can post public updates and internal notes
        allow create: if isAuthenticated() && (
          isProjectManager() ||
          request.resource.data.actorId == request.auth.uid
        );

        allow update, delete: if isProjectManager();
      }
    }

    // ==========================================
    // 5. Suggestions Collection (suggestions/{suggestionId})
    // ==========================================
    match /suggestions/{suggestionId} {
      // Public transparency: citizens and authority can read suggestions
      allow read: if isAuthenticated();

      // Citizen can create suggestion with their own citizenId
      allow create: if isAuthenticated() &&
                    request.resource.data.citizenId == request.auth.uid;

      // Citizen can update only their own suggestion while pending review
      // Authority (PM) can update status and official responses
      allow update: if (isAuthenticated() && resource.data.citizenId == request.auth.uid) ||
                    isProjectManager();

      allow delete: if isProjectManager();

      // Suggestion Updates and Audit Subcollection
      match /updates/{updateId} {
        // Public updates visible to all authenticated users
        // Internal notes (isInternal == true) strictly restricted to Project Managers
        allow read: if isAuthenticated() && (
          isProjectManager() ||
          resource.data.isInternal == false
        );

        allow create: if isAuthenticated() && (
          isProjectManager() ||
          request.resource.data.actorId == request.auth.uid
        );

        allow update, delete: if isProjectManager();
      }
    }

    // ==========================================
    // 6. Civic Polls Collection (polls/{pollId})
    // ==========================================
    match /polls/{pollId} {
      // Authenticated users can read polls
      allow read: if isAuthenticated();

      // Project managers create and delete polls
      allow create, delete: if isProjectManager();

      // PM can update all fields (status, options, dates)
      // Citizens can increment vote counters via atomic transactions
      allow update: if isProjectManager() ||
                    (isAuthenticated() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'totalVotes', 'updatedAt']));

      // One-User-One-Vote Subcollection (polls/{pollId}/votes/{userId})
      match /votes/{userId} {
        // Voter can read their own ballot; PM can verify audits
        allow read: if isAuthenticated() && (request.auth.uid == userId || isProjectManager());

        // Strictly enforce One-User-One-Vote:
        // 1. Must be authenticated
        // 2. Document ID in path must equal authenticated UID
        // 3. Document body userId must equal authenticated UID
        allow create: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      request.resource.data.userId == request.auth.uid;

        // Ballots are completely immutable: once cast, cannot be modified or deleted
        allow update, delete: if false;
      }
    }

    // ==========================================
    // 7. Contractor Project Submissions (projectSubmissions/{submissionId})
    // ==========================================
    match /projectSubmissions/{submissionId} {
      // Contractors can read ONLY their own submissions; Project Managers can read all
      allow read: if isAuthenticated() && (
        isProjectManager() ||
        (isContractor() && resource.data.contractorId == request.auth.uid)
      );

      // Contractors can create submissions strictly for projects assigned to them
      // Cannot self-approve or start with status other than 'Submitted'
      allow create: if isContractor() &&
                    request.resource.data.contractorId == request.auth.uid &&
                    request.resource.data.status == 'Submitted';

      // Only authorized Project Managers can review (Approve / Reject / Request Changes)
      // Contractors CANNOT update or self-approve submissions once submitted
      allow update: if isProjectManager();

      // Deletion strictly limited to Project Managers
      allow delete: if isProjectManager();
    }

    // Default deny for unhandled routes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
